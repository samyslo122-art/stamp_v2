<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Redemption Counter — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8' }}}}}
  </script>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    #qr-reader { border: none !important; }
    #qr-reader video { object-fit: cover; border-radius: 1rem; }
    .scan-overlay { position: absolute; inset: 0; border: 4px solid #3b82f6; border-radius: 1rem; animation: pulse-border 2s infinite; pointer-events: none; z-index: 10; }
    @keyframes pulse-border { 0%, 100% { opacity: 0.3; transform: scale(0.98); } 50% { opacity: 0.7; transform: scale(1); } }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50/30 to-slate-50">
  <%- include('partials/admin-nav', { active: 'redeem' }) %>
  <%- include('partials/modal') %>
  <main class="mx-auto max-w-5xl px-4 py-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="h-10 w-10 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-lg">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c.533.479.533 1.284 0 1.764l-4.58 4.12a2.33 2.33 0 01-3.12 0l-4.58-4.12a1.18 1.18 0 010-1.764 1.34 1.18 0 011.88 0l2.7 2.43 2.7-2.43a1.34 1.18 0 011.88 0zM12 2a5 5 0 00-5 5v3H5a2 2 0 00-2 2v8a2 2 0 002 2h14a2 2 0 002-2v-8a2 2 0 00-2-2h-2V7a5 5 0 00-5-5zM9 7a3 3 0 016 0v3H9V7z"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-slate-800">Gifts & Redemption</h1>
    </div>

    

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Scanner Column -->
      <div class="lg:col-span-4 space-y-6">
        <div class="relative rounded-2xl bg-black aspect-square overflow-hidden shadow-xl border-4 border-white">
          <div id="qr-reader" class="w-full h-full"></div>
          <div id="scanner-overlay" class="scan-overlay"></div>
        </div>

        <div class="rounded-2xl border border-slate-200/60 bg-white/80 backdrop-blur-sm p-6 shadow-sm">
          <label for="playerId" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Player Identification</label>
          <input id="playerId" type="text" maxlength="6"
            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-lg font-mono text-center uppercase focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 focus:outline-none transition-all shadow-sm"
            placeholder="AB12C3" autocomplete="off" />
          <button onclick="lookupPlayer()" class="w-full mt-3 rounded-xl bg-brand-600 py-3 text-sm font-bold text-white shadow-lg hover:bg-brand-700 active:scale-95 transition-all">CHECK ELIGIBILITY</button>
        </div>
      </div>

      <!-- Eligibility Column -->
      <div class="lg:col-span-8 space-y-6">
        <div id="player-info-card" class="hidden rounded-2xl border border-slate-200/60 bg-white/80 backdrop-blur-sm p-6 shadow-sm">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-4">
              <div id="p-avatar" class="h-14 w-14 rounded-2xl bg-brand-500 flex items-center justify-center text-white text-xl font-bold"></div>
              <div>
                <h2 id="p-name" class="text-xl font-bold text-slate-800"></h2>
                <p id="p-id" class="font-mono text-sm text-slate-500"></p>
              </div>
            </div>
            <div class="text-right">
              <div class="inline-flex flex-col items-end">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Stamp Total</span>
                <span id="p-stamps" class="text-3xl font-black text-brand-600 leading-none"></span>
              </div>
            </div>
          </div>
          <div class="flex flex-wrap gap-2" id="p-categories"></div>
        </div>

        <div id="tiers-container" class="space-y-4">
           <!-- Placeholder -->
           <div id="welcome-state" class="flex flex-col items-center justify-center py-20 text-center text-slate-400 bg-slate-50/50 rounded-2xl border-2 border-dashed border-slate-200">
             <svg class="h-16 w-16 mb-4 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h2m-6 0h2m-4 6h10M4 7h16M4 7a2 2 0 012-2h12a2 2 0 012 2M4 7v10a2 2 0 002 2h12a2 2 0 002-2V7"/></svg>
             <p class="text-sm font-medium">Scan player QR to start redemption process</p>
           </div>
        </div>

        <!-- Danger Zone / Round Reset -->
        <div id="reset-zone" class="hidden rounded-2xl border border-amber-200 bg-amber-50 p-6">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-bold text-amber-900 uppercase tracking-tight">Round Progression</h3>
              <p class="text-xs text-amber-700 mt-1">Player keeps all stamps but starts a fresh collection cycle.</p>
            </div>
            <button onclick="resetRound()" class="rounded-xl bg-amber-600 px-6 py-3 text-xs font-bold text-white shadow hover:bg-amber-700 active:scale-95 transition-all">ADVANCE ROUND</button>
          </div>
        </div>

        <div id="redeem-msg" class="hidden rounded-xl p-4 text-sm font-bold border text-center"></div>
      </div>
    </div>
  </main>

  <script src="/js/common.js"></script>
  <script>
    const csrfToken = '<%= csrfToken %>';
    let html5QrCode = null;
    let lastScanTime = 0;
    let currentPlayer = null;

    async function lookupPlayer() {
      const id = document.getElementById('playerId').value.trim().toUpperCase();
      if (!id) return;
      try {
        console.log('[lookupPlayer] Sending request for:', id);
        const res = await fetch('/api/admin/redemption/lookup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ uniqueId: id })
        });
        console.log('[lookupPlayer] Response status:', res.status);
        const data = await res.json();
        console.log('[lookupPlayer] Response data:', data);
        if (!res.ok) { showMsg(data.error || 'Player not found', 'error'); return; }
        currentPlayer = data;
        renderPlayer(data);
      } catch(e) { console.error('[lookupPlayer] Error:', e); showMsg('Connection error: ' + e.message, 'error'); }
    }

    function renderPlayer(data) {
      console.log('[renderPlayer] Starting with data:', data?.name);
      const welcomeState = document.getElementById('welcome-state');
      const playerCard = document.getElementById('player-info-card');
      const resetZoneEl = document.getElementById('reset-zone');

      console.log('[renderPlayer] Elements:', { welcomeState: !!welcomeState, playerCard: !!playerCard, resetZone: !!resetZoneEl });

      if (welcomeState) welcomeState.classList.add('hidden');
      if (playerCard) playerCard.classList.remove('hidden');
      if (resetZoneEl) resetZoneEl.classList.remove('hidden');

      document.getElementById('p-name').textContent = data.name;
      document.getElementById('p-id').textContent = 'UID: ' + data.uniqueId;
      document.getElementById('p-stamps').textContent = data.stampTotal;
      document.getElementById('p-avatar').textContent = data.name.charAt(data.name.length-1);

      const canAdvance = data.stampTotal >= 12;
      const resetZone = document.getElementById('reset-zone');
      resetZone.innerHTML = `
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-bold ${canAdvance ? 'text-amber-900' : 'text-slate-500'} uppercase tracking-tight">Round Progression</h3>
            <p class="text-xs ${canAdvance ? 'text-amber-700' : 'text-slate-400'} mt-1">
              ${canAdvance ? 'Player keeps all stamps but starts a fresh collection cycle.' : 'Collect all 12 stamps to unlock round advancement.'}
            </p>
          </div>
          <button onclick="resetRound()" ${canAdvance ? '' : 'disabled'} 
            class="rounded-xl ${canAdvance ? 'bg-amber-600 hover:bg-amber-700' : 'bg-slate-300 cursor-not-allowed'} px-6 py-3 text-xs font-bold text-white shadow active:scale-95 transition-all">
            ADVANCE ROUND
          </button>
        </div>
      `;

      const catEl = document.getElementById('p-categories');
      if (catEl) {
      catEl.innerHTML = (data.categoriesCollected || []).map(c =>
        `<span class="px-3 py-1 rounded-full bg-white border border-brand-200 text-[10px] font-bold text-brand-700 uppercase">Category ${c}</span>`
      ).join('') || '<span class="text-xs text-slate-400 italic">No categories collected this round</span>';
      }

      const tiersEl = document.getElementById('tiers-container');
      if (tiersEl) {
      tiersEl.innerHTML = data.tiers.map(t => {
        const status = t.alreadyRedeemed ? 'REDEEMED' : t.eligible ? 'AVAILABLE' : 'LOCKED';
        const colorClass = t.alreadyRedeemed ? 'bg-slate-100 border-slate-200 grayscale' : t.eligible ? 'bg-white border-emerald-300 ring-2 ring-emerald-500/10' : 'bg-white border-slate-200 opacity-60';
        
        const giftsHtml = t.eligible ? (t.gifts || []).map(g => {
          const remaining = g.remaining || 0;
          const isOutOfStock = remaining === 0;
          const stockColor = isOutOfStock ? 'text-slate-300' : 'text-white';
          const btnClass = isOutOfStock
            ? 'flex-1 rounded-xl bg-slate-200 py-3 text-xs font-bold text-slate-400 cursor-not-allowed'
            : 'flex-1 rounded-xl bg-brand-600 py-3 text-xs font-bold text-white shadow-md hover:bg-brand-700 active:scale-95 transition-all';
          const stockLabel = isOutOfStock ? 'OUT OF STOCK' : `(${remaining} left)`;
          return `<button onclick="${isOutOfStock ? '' : `claimGift('${t.key}','${g.name.replace(/'/g, "\\'")}',${remaining})`}"
            class="${btnClass}" ${isOutOfStock ? 'disabled' : ''}>
            ${isOutOfStock ? '✕ ' : '✓ '} ${g.name.toUpperCase()} <span class="${stockColor}">${stockLabel}</span>
          </button>`;
        }).join('') : '';

        return `
          <div class="rounded-2xl border-2 p-6 transition-all ${colorClass}">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-black text-slate-800 text-lg uppercase tracking-tight">${t.name}</h3>
                <p class="text-xs text-slate-500">${t.requiredStamps} Stamps &middot; ${t.requireAllCategories ? 'All 3 Categories' : '≥'+t.minCategories+' Categories'}</p>
              </div>
              <div class="text-right">
                ${t.eligible && t.gifts && t.gifts.length > 0 ? `<p class="text-[10px] font-bold text-slate-400">${t.gifts.length} GIFT${t.gifts.length>1?'S':''} AVAILABLE</p>` : ''}
                <span class="mt-1 block px-3 py-1 rounded-lg font-black text-[10px] tracking-widest ${t.eligible ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-500'}">${status}</span>
              </div>
            </div>
            <div class="flex gap-2">${giftsHtml || (t.alreadyRedeemed ? '<p class="text-sm font-bold text-slate-400 italic text-center w-full">Gift already claimed for this round</p>' : '')}</div>
          </div>
        `;
      }).join('');
    }
    }

    async function claimGift(tierKey, giftName, remainingStock) {
      if (!currentPlayer) return;
      
      const stockInfo = remainingStock !== undefined ? ` (${remainingStock} currently in stock)` : '';
      const confirmed = await ConfirmModal.show({
        title: 'Confirm Redemption',
        message: `Confirm issuing "${giftName}" to ${currentPlayer.name}?${stockInfo} This will record the redemption and update inventory.`,
        confirmText: 'Confirm Redemption'
      });
      if (!confirmed) return;

      try {
        console.log('[claimGift] Sending request:', { uniqueId: currentPlayer.uniqueId, tierKey, giftName });
        const res = await fetch('/api/admin/redemption/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ uniqueId: currentPlayer.uniqueId, tierKey, giftName })
        });
        console.log('[claimGift] Response status:', res.status);
        const data = await res.json();
        console.log('[claimGift] Response data:', data);
        if (!res.ok) { showMsg(data.error || 'Claim failed', 'error'); return; }
        showMsg(`SUCCESS: ${giftName} issued!`, 'success');
        lookupPlayer();
      } catch(e) { console.error('[claimGift] Error:', e); showMsg('Claim failed: ' + e.message, 'error'); }
    }

    async function resetRound() {
      if (!currentPlayer) return;

      const confirmed = await ConfirmModal.show({
        title: 'Advance Round',
        message: `Advance ${currentPlayer.name} to Round ${currentPlayer.currentRound + 1}? They will keep their lifetime stamps but start a fresh category collection cycle.`,
        confirmText: 'Advance Round',
        type: 'info'
      });
      if (!confirmed) return;

      try {
        const res = await fetch('/api/admin/rounds/reset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ uniqueId: currentPlayer.uniqueId })
        });
        const data = await res.json();
        if (!res.ok) { showMsg(data.error || 'Reset failed', 'error'); return; }
        showMsg(`PLAYER ADVANCED TO ROUND ${data.newRound}`, 'success');
        lookupPlayer();
      } catch(e) { showMsg('Reset failed. Please try again.', 'error'); }
    }

    function showMsg(msg, type) {
      const el = document.getElementById('redeem-msg');
      el.classList.remove('hidden');
      el.className = `mt-6 rounded-xl p-5 text-sm font-black border text-center uppercase tracking-wide shadow-lg animate-bounce ${type === 'error' ? 'bg-red-600 text-white border-red-700' : 'bg-emerald-600 text-white border-emerald-700'}`;
      el.textContent = msg;
      setTimeout(() => el.classList.add('hidden'), 5000);
    }

    function initScanner() {
      html5QrCode = new Html5Qrcode("qr-reader");
      html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: { width: 250, height: 250 } }, (text) => {
        const now = Date.now();
        if (now - lastScanTime < 2000) return;
        lastScanTime = now;
        let id = text.trim();
        const match = id.match(/\/player\/([A-Z0-9]{6})/i);
        if (match) id = match[1];
        document.getElementById('playerId').value = id.toUpperCase();
        document.getElementById('scanner-overlay').style.borderColor = '#10b981';
        setTimeout(() => { document.getElementById('scanner-overlay').style.borderColor = '#3b82f6'; }, 1000);
        lookupPlayer();
      }).catch(err => { });
    }

    document.addEventListener('DOMContentLoaded', initScanner);
  </script>
</body>
</html>
