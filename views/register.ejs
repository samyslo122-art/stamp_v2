<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <title>Register — <%= eventDetails.Event %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd',
              400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8',
              800: '#1e40af', 900: '#1e3a8a'
            },
            surface: '#ffffff',
            background: '#f8fafc'
          },
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
          },
          boxShadow: {
            'soft': '0 2px 8px 0 rgba(0, 0, 0, 0.04), 0 4px 24px 0 rgba(0, 0, 0, 0.06)',
            'card': '0 4px 12px 0 rgba(0, 0, 0, 0.05), 0 1px 3px 0 rgba(0, 0, 0, 0.08)'
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      -webkit-touch-callout: none;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #f1f5f9;
      min-height: 100dvh;
      overscroll-behavior: none;
    }
    
    .app-container {
      max-width: 430px;
      margin: 0 auto;
      min-height: 100dvh;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      position: relative;
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.08);
    }
    
    @media (min-width: 431px) {
      .app-container {
        min-height: 100vh;
        margin: 16px auto;
        border-radius: 24px;
        overflow: hidden;
      }
    }
    
    .status-bar {
      height: env(safe-area-inset-top, 44px);
      min-height: 44px;
    }
    
    .scanner-frame {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      background: #000;
    }
    
    .scanner-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    
    .scanner-corner {
      position: absolute;
      width: 24px;
      height: 24px;
      border-color: #3b82f6;
      border-style: solid;
      border-width: 0;
    }
    
    .scanner-corner.top-left { top: 16px; left: 16px; border-top-width: 3px; border-left-width: 3px; border-top-left-radius: 8px; }
    .scanner-corner.top-right { top: 16px; right: 16px; border-top-width: 3px; border-right-width: 3px; border-top-right-radius: 8px; }
    .scanner-corner.bottom-left { bottom: 16px; left: 16px; border-bottom-width: 3px; border-left-width: 3px; border-bottom-left-radius: 8px; }
    .scanner-corner.bottom-right { bottom: 16px; right: 16px; border-bottom-width: 3px; border-right-width: 3px; border-bottom-right-radius: 8px; }
    
    #qr-reader { border: none !important; }
    #qr-reader > div { border: none !important; box-shadow: none !important; }
    #qr-reader__scan_region { background: transparent !important; }
    #qr-reader__scan_region > div { border: none !important; box-shadow: none !important; }
    #qr-reader__dashboard { display: none !important; }
    #qr-reader__status_span { display: none !important; }
    #qr-reader__dashboard_section_swaplink { display: none !important; }
    
    .input-field {
      transition: all 0.2s ease;
    }
    
    .input-field:focus {
      transform: scale(1.01);
    }
    
    .btn-primary {
      transition: all 0.2s ease;
    }
    
    .btn-primary:not(:disabled):active {
      transform: scale(0.98);
    }
    
    .btn-primary:disabled {
      opacity: 0.6;
    }
    
    .slide-up-enter {
      animation: slideUp 0.3s ease-out;
    }
    
    @keyframes slideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    
    .fade-in {
      animation: fadeIn 0.3s ease-out;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .modal-backdrop {
      animation: fadeIn 0.2s ease-out;
    }
    
    .modal-content {
      animation: slideUp 0.3s ease-out;
    }
    
    .status-badge {
      animation: fadeIn 0.3s ease-out;
    }
    
    .camera-error {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
    }
    
    .scan-success {
      animation: scanSuccess 0.6s ease-out;
    }
    
    @keyframes scanSuccess {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      50% { box-shadow: 0 0 0 12px rgba(16, 185, 129, 0.3); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
  </style>
</head>
<body>
  <div class="app-container">
    
    <!-- App Header -->
    <header class="sticky top-0 z-20 bg-white/80 backdrop-blur-lg border-b border-slate-100">
      <div class="px-5 py-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
            </div>
            <div>
              <h1 class="text-base font-semibold text-slate-800 leading-tight">Event Passport</h1>
              <p class="text-xs text-slate-500"><%= eventDetails.Event %></p>
          </div>
          </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="px-5 pb-8">
      <!-- Welcome Section -->
      <div class="pt-6 pb-5 text-center">
        <p class="text-sm text-slate-500">Scan your group QR code or enter code to register</p>
      </div>
      


      <!-- Scanner Card -->
      <div class="rounded-2xl bg-white shadow-card overflow-hidden mb-5">
        <div class="p-4 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
            <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Camera Active</span>
          </div>
        </div>
        
        <!-- Scanner -->
        <div id="scanner-wrapper" class="relative scanner-frame aspect-square mx-4 my-4">
          <div id="qr-reader" class="w-full h-full"></div>
          <div class="scanner-overlay">
            <div class="scanner-corner top-left"></div>
            <div class="scanner-corner top-right"></div>
            <div class="scanner-corner bottom-left"></div>
            <div class="scanner-corner bottom-right"></div>
          </div>
          <div id="camera-error" class="hidden absolute inset-0 camera-error rounded-xl">
            <svg class="w-14 h-14 text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-sm font-medium text-slate-600 mb-1">Camera unavailable</p>
            <p class="text-xs text-slate-400 text-center px-4">Use the code input below to continue</p>
          </div>
        </div>
        

      </div>

      <!-- Divider -->
      <div class="flex items-center gap-4 mb-5">
        <div class="flex-1 h-px bg-slate-200"></div>
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">or enter code manually</span>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>

      <!-- Manual Input Card -->
      <div class="rounded-2xl bg-white shadow-card p-5 mb-5">
        <label for="groupCode" class="block text-sm font-medium text-slate-700 mb-3">Group Code</label>
        <input id="groupCode" type="text" maxlength="20"
          class="input-field w-full rounded-xl border-2 border-slate-200 bg-slate-50 px-5 py-4 text-lg font-semibold uppercase tracking-wider text-center placeholder:text-slate-300 placeholder:tracking-normal placeholder:font-normal focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-500/10"
          placeholder="Enter your code" autocomplete="off" autocapitalize="characters" />
      </div>

      <!-- Status Messages -->
      <div id="status-msg" class="hidden status-badge mb-5">
        <div id="status-content" class="rounded-xl p-4 flex items-start gap-3">
          <div id="status-icon" class="w-5 h-5 flex-shrink-0 mt-0.5"></div>
          <p id="status-text" class="text-sm font-medium flex-1"></p>
        </div>
      </div>

      <!-- Continue Button -->
      <button id="continueBtn" type="button" disabled
        class="btn-primary w-full rounded-xl bg-brand-500 px-6 py-4 text-base font-semibold text-white shadow-lg disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none"
        onclick="showConfirmModal()">
        Continue
      </button>
    </main>

    <!-- Confirmation Modal -->
    <div id="confirmModal" class="hidden fixed inset-0 z-50">
      <div class="modal-backdrop absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="hideConfirmModal()"></div>
      <div class="absolute inset-x-4 bottom-0 max-w-md mx-auto">
        <div class="modal-content bg-white rounded-t-2xl p-6 pb-8 safe-area-bottom">
          <div class="w-12 h-1 bg-slate-300 rounded-full mx-auto mb-6"></div>
          
          <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-brand-50 border-2 border-brand-100 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-800 mb-1">Confirm Registration</h3>
            <p class="text-sm text-slate-500">You're about to register for this event</p>
          </div>
          
          <div class="bg-slate-50 rounded-xl p-4 mb-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Group</span>
              <span id="modal-group" class="text-sm font-semibold text-slate-800"></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Available</span>
              <span id="modal-spots" class="text-sm font-semibold text-emerald-600"></span>
            </div>
          </div>
          
          <div class="space-y-3">
            <button id="confirmBtn" type="button"
              class="btn-primary w-full rounded-xl bg-brand-500 px-6 py-4 text-base font-semibold text-white shadow-lg flex items-center justify-center gap-2"
              onclick="doRegister()">
              <span>Confirm & Register</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </button>
            <button type="button"
              class="btn-primary w-full rounded-xl bg-slate-100 px-6 py-4 text-base font-medium text-slate-600"
              onclick="hideConfirmModal()">
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="hidden fixed inset-0 z-50 bg-white/90 backdrop-blur-sm flex items-center justify-center">
      <div class="text-center">
        <div class="w-16 h-16 border-4 border-brand-200 border-t-brand-500 rounded-full animate-spin mx-auto mb-4"></div>
        <p class="text-sm font-medium text-slate-600">Processing registration...</p>
      </div>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script>
    const csrfToken = '<%= csrfToken %>';
    let html5QrCode = null;
    let isProcessing = false;
    let lastScanTime = 0;
    let currentGroupData = null;

    const groupInput = document.getElementById('groupCode');
    const continueBtn = document.getElementById('continueBtn');
    const statusMsg = document.getElementById('status-msg');
    const statusContent = document.getElementById('status-content');
    const statusText = document.getElementById('status-text');
    const statusIcon = document.getElementById('status-icon');
    const confirmModal = document.getElementById('confirmModal');
    const loadingOverlay = document.getElementById('loadingOverlay');

    function showStatus(msg, type) {
      statusMsg.classList.remove('hidden');
      statusText.textContent = msg;
      
      statusContent.className = 'rounded-xl p-4 flex items-start gap-3';
      
      if (type === 'error') {
        statusContent.classList.add('bg-red-50', 'border', 'border-red-100');
        statusIcon.innerHTML = '<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        statusText.className = 'text-sm font-medium text-red-700 flex-1';
      } else if (type === 'warning') {
        statusContent.classList.add('bg-amber-50', 'border', 'border-amber-100');
        statusIcon.innerHTML = '<svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>';
        statusText.className = 'text-sm font-medium text-amber-700 flex-1';
      } else {
        statusContent.classList.add('bg-emerald-50', 'border', 'border-emerald-100');
        statusIcon.innerHTML = '<svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        statusText.className = 'text-sm font-medium text-emerald-700 flex-1';
      }
    }

    function hideStatus() {
      statusMsg.classList.add('hidden');
      currentGroupData = null;
    }

    let debounceTimer = null;
    groupInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const val = groupInput.value.trim().toUpperCase();
      
      if (val.length === 0) {
        hideStatus();
        continueBtn.disabled = true;
        continueBtn.textContent = 'Continue';
        return;
      }
      
      if (val.length < 3) {
        continueBtn.disabled = true;
        continueBtn.textContent = 'Continue';
        return;
      }
      
      debounceTimer = setTimeout(() => validateGroup(val), 300);
    });

    async function validateGroup(code) {
      if (isProcessing) return;
      isProcessing = true;
      
      try {
        const res = await fetch(`/api/groups/validate/${encodeURIComponent(code)}`);
        const data = await res.json();
        
        if (!res.ok || !data.found) {
          showStatus('Group not found. Please check the code.', 'error');
          continueBtn.disabled = true;
          continueBtn.textContent = 'Continue';
        } else if (!data.checked_in) {
          showStatus('This group is waiting for staff check-in.', 'warning');
          continueBtn.disabled = true;
          continueBtn.textContent = 'Continue';
        } else if (data.remaining <= 0) {
          showStatus('This group has reached maximum capacity.', 'error');
          continueBtn.disabled = true;
          continueBtn.textContent = 'Continue';
        } else {
          currentGroupData = data;
          continueBtn.disabled = false;
          continueBtn.textContent = 'Continue';
          showConfirmModal();
        }
      } catch (err) {
        showStatus('Connection error. Please check your network.', 'error');
        continueBtn.disabled = true;
        continueBtn.textContent = 'Continue';
      } finally {
        isProcessing = false;
      }
    }

    function showConfirmModal() {
      if (!currentGroupData) return;
      
      const code = groupInput.value.trim().toUpperCase();
      document.getElementById('modal-group').textContent = `Group ${code}`;
      document.getElementById('modal-spots').textContent = `${currentGroupData.remaining} spot${currentGroupData.remaining !== 1 ? 's' : ''} available`;
      
      confirmModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function hideConfirmModal() {
      confirmModal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    async function doRegister() {
      if (isProcessing) return;
      isProcessing = true;
      
      hideConfirmModal();
      loadingOverlay.classList.remove('hidden');
      
      const confirmBtn = document.getElementById('confirmBtn');
      const originalContent = confirmBtn.innerHTML;
      confirmBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Processing...</span>';
      confirmBtn.disabled = true;

      try {
        const res = await fetch('/api/players/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ groupCode: groupInput.value.trim().toUpperCase() }),
        });
        const data = await res.json();
        
        if (!res.ok) {
          loadingOverlay.classList.add('hidden');
          confirmBtn.innerHTML = originalContent;
          confirmBtn.disabled = false;
          showStatus(data.error || 'Registration failed. Please try again.', 'error');
          return;
        }
        
        window.location.href = `/player/${data.uniqueId}`;
      } catch (err) {
        loadingOverlay.classList.add('hidden');
        confirmBtn.innerHTML = originalContent;
        confirmBtn.disabled = false;
        showStatus('Connection error. Please try again.', 'error');
        isProcessing = false;
      }
    }

    function initScanner() {
      html5QrCode = new Html5Qrcode("qr-reader");
      const config = { fps: 10, qrbox: { width: 260, height: 260 } };

      html5QrCode.start({ facingMode: "environment" }, config, (decodedText) => {
        const now = Date.now();
        if (now - lastScanTime < 2500) return;
        
        lastScanTime = now;
        
        const scannerWrapper = document.getElementById('scanner-wrapper');
        scannerWrapper.classList.add('scan-success');
        setTimeout(() => scannerWrapper.classList.remove('scan-success'), 600);
        
        groupInput.value = decodedText.trim().toUpperCase();
        validateGroup(groupInput.value);
      }).catch(err => {
        console.error("Scanner error", err);
        document.getElementById('camera-error').classList.remove('hidden');
      });
    }

    document.addEventListener('DOMContentLoaded', initScanner);
  </script>
</body>
</html>
