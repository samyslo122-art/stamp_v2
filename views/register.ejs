<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <title>Register — <%= eventDetails.Event %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd',
              400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8',
              800: '#1e40af', 900: '#1e3a8a'
            },
            surface: '#ffffff',
            background: '#f8fafc'
          },
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
          },
          boxShadow: {
            'soft': '0 8px 30px rgba(0, 0, 0, 0.04)',
            'float': '0 20px 40px rgba(0, 0, 0, 0.08)'
          }
        }
      }
    }
  </script>
  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      -webkit-touch-callout: none;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #f1f5f9;
      margin: 0;
      padding: 0;
      min-height: 100dvh;
      overscroll-behavior: none;
    }
    
    .app-container {
      max-width: 430px;
      margin: 0 auto;
      min-height: 100dvh;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      position: relative;
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
    }
    
    @media (min-width: 431px) {
      .app-container {
        min-height: 100vh;
        margin: 16px auto;
        border-radius: 24px;
        overflow: hidden;
      }
    }
    
    .input-field {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .input-field:focus {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.1), 0 8px 10px -6px rgba(59, 130, 246, 0.1);
    }
    
    .btn-primary {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .btn-primary:not(:disabled):active {
      transform: scale(0.96);
    }
    
    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Bottom Sheet Animation */
    .sheet-enter {
      animation: slideUpSheet 0.3s cubic-bezier(0.3, 1, 0.3, 1) forwards;
    }
    .sheet-exit {
      animation: slideDownSheet 0.2s cubic-bezier(0.4, 0, 1, 1) forwards;
    }
    
    @keyframes slideUpSheet {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
    @keyframes slideDownSheet {
      from { transform: translateY(0); }
      to { transform: translateY(100%); }
    }

    /* Toast Animation */
    .toast-enter {
      animation: slideDownToast 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    .toast-exit {
      animation: slideUpToast 0.3s cubic-bezier(0.4, 0, 1, 1) forwards;
    }
    @keyframes slideDownToast {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @keyframes slideUpToast {
      from { transform: translateY(0); opacity: 1; }
      to { transform: translateY(-100%); opacity: 0; }
    }

    .fade-in {
      animation: fadeIn 0.2s ease-out forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="app-container">
    
    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-0 inset-x-0 z-50 p-4 pointer-events-none flex flex-col gap-2 max-w-[430px] mx-auto"></div>

    <!-- App Header -->
    <header class="pt-12 pb-4 px-6 bg-transparent">
      <div class="flex flex-col items-center justify-center text-center">
        <div class="w-16 h-16 mb-4 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center shadow-float">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight leading-tight mb-2">Event Passport</h1>
        <p class="text-sm font-medium text-slate-500 max-w-[280px] leading-relaxed">Other Languages Experience Day: Learn. Showcase. Connect.</p>
        <p class="text-sm font-medium text-slate-500 max-w-[280px] leading-relaxed">(學展同樂：其他語言體驗日)</p>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col justify-center px-6 pb-24">
      <div class="bg-white rounded-[24px] shadow-soft p-6 mb-4 border border-slate-100">
        <div class="text-center mb-6">
          <h2 class="text-lg font-semibold text-slate-800">Welcome</h2>
          <p class="text-sm text-slate-500 mt-1">Enter your Player ID to access your passport.</p>
        </div>
        
        <div class="relative">
          <label for="playerId" class="sr-only">Player ID</label>
          <input id="playerId" type="text" maxlength="6" inputmode="numeric"
            class="input-field w-full rounded-2xl border-2 border-slate-100 bg-slate-50/50 px-6 py-5 text-3xl font-bold tracking-[0.2em] text-center text-slate-800 placeholder:text-slate-300 placeholder:font-medium placeholder:tracking-normal focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-500/10 transition-all"
            placeholder="000" autocomplete="off" />
        </div>
      </div>
    </main>

    <!-- Bottom Action Area -->
    <div class="fixed bottom-0 inset-x-0 pb-safe z-30 max-w-[430px] mx-auto bg-gradient-to-t from-white via-white to-transparent pt-12 pb-6 px-6">
      <button id="continueBtn" type="button" disabled
        class="btn-primary w-full h-14 rounded-2xl bg-brand-600 text-lg font-semibold text-white shadow-[0_8px_20px_rgba(37,99,235,0.24)] disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none flex items-center justify-center gap-2"
        onclick="showConfirmSheet()">
        <span>Continue</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

    <!-- Bottom Sheet Confirmation -->
    <div id="confirmSheetOverlay" class="hidden fixed inset-0 z-40 bg-slate-900/40 backdrop-blur-sm fade-in" onclick="hideConfirmSheet()"></div>
    <div id="confirmSheet" class="fixed inset-x-0 bottom-0 z-50 max-w-[430px] mx-auto transform translate-y-full transition-transform duration-300 ease-out">
      <div class="bg-white rounded-t-[32px] p-6 pb-12 shadow-float border-t border-slate-100">
        <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-8"></div>
        
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-50 text-brand-600 mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2">Confirm Your ID</h3>
          <p class="text-base text-slate-500">Are you sure your Player ID is</p>
          <div class="mt-3 text-4xl font-bold tracking-widest text-brand-600" id="sheetPlayerId"></div>
        </div>
        
        <div class="space-y-3">
          <button id="confirmBtn" type="button"
            class="btn-primary w-full h-14 rounded-2xl bg-brand-600 text-lg font-semibold text-white shadow-[0_8px_20px_rgba(37,99,235,0.24)]"
            onclick="doRegister()">
            Yes, Let's Go!
          </button>
          <button type="button"
            class="btn-primary w-full h-14 rounded-2xl bg-slate-100 text-lg font-semibold text-slate-700"
            onclick="hideConfirmSheet()">
            Cancel
          </button>
        </div>
      </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="hidden fixed inset-0 z-[60] bg-white/80 backdrop-blur-md flex items-center justify-center fade-in">
      <div class="bg-white p-6 rounded-3xl shadow-float flex flex-col items-center">
        <div class="w-12 h-12 border-4 border-brand-100 border-t-brand-600 rounded-full animate-spin mb-4"></div>
        <p class="text-sm font-semibold text-slate-700">Connecting...</p>
      </div>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script>
    const csrfToken = '<%= csrfToken %>';
    let isProcessing = false;

    const playerInput = document.getElementById('playerId');
    const continueBtn = document.getElementById('continueBtn');
    const confirmSheet = document.getElementById('confirmSheet');
    const confirmSheetOverlay = document.getElementById('confirmSheetOverlay');
    const sheetPlayerId = document.getElementById('sheetPlayerId');
    const loadingOverlay = document.getElementById('loadingOverlay');

    // Custom Toast Notification Function
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      const isError = type === 'error';
      const bgColor = isError ? 'bg-red-500' : 'bg-emerald-500';
      const icon = isError 
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />';
      
      toast.className = `flex items-center gap-3 w-full p-4 rounded-2xl shadow-float text-white ${bgColor} toast-enter`;
      toast.innerHTML = `
        <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">${icon}</svg>
        <p class="text-sm font-semibold">${message}</p>
      `;
      
      container.appendChild(toast);
      
      setTimeout(() => {
        toast.classList.replace('toast-enter', 'toast-exit');
        toast.addEventListener('animationend', () => toast.remove());
      }, 3000);
    }

    // Input handling
    playerInput.addEventListener('input', (e) => {
      // Allow alphanumeric just in case, but styled for numeric
      let val = e.target.value.trim().toUpperCase();
      e.target.value = val;
      continueBtn.disabled = val.length === 0;
    });

    // Enter key submits
    playerInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !continueBtn.disabled) {
        playerInput.blur();
        showConfirmSheet();
      }
    });

    function showConfirmSheet() {
      const val = playerInput.value.trim().toUpperCase();
      if (!val) return;
      sheetPlayerId.textContent = val;
      
      confirmSheetOverlay.classList.remove('hidden');
      // small delay to ensure display:block applies before transform
      requestAnimationFrame(() => {
        confirmSheet.classList.remove('translate-y-full');
      });
    }

    function hideConfirmSheet() {
      confirmSheet.classList.add('translate-y-full');
      setTimeout(() => {
        confirmSheetOverlay.classList.add('hidden');
      }, 300); // match transition duration
    }

    async function doRegister() {
      if (isProcessing) return;
      isProcessing = true;
      
      hideConfirmSheet();
      loadingOverlay.classList.remove('hidden');
      
      const playerId = playerInput.value.trim().toUpperCase();

      try {
        const res = await fetch('/api/players/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ playerId }),
        });
        const data = await res.json();
        
        if (!res.ok) {
          loadingOverlay.classList.add('hidden');
          showToast(data.error || 'Invalid ID. Please try again.', 'error');
          isProcessing = false;
          return;
        }
        
        // Success - redirect to passport
        window.location.href = `/player/${data.uniqueId}`;
      } catch (err) {
        loadingOverlay.classList.add('hidden');
        showToast('Connection error. Please try again.', 'error');
        isProcessing = false;
      }
    }
  </script>
</body>
</html>