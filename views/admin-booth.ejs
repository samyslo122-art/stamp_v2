<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stamp Station — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8' }}}}}
  </script>
  <link rel="stylesheet" href="/css/style.css" />
  <style></style>
</head>
<body class="min-h-screen bg-slate-50">
  <%- include('partials/admin-nav', { active: 'booth' }) %>
  <%- include('partials/modal') %>

  <div id="toast-wrap"></div>

  <main class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex items-center gap-3 mb-8">
      <div class="h-11 w-11 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Stamp Station</h1>
        <p class="text-sm text-slate-500">Issue or revoke player stamps by booth</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
              <span class="text-sm font-semibold text-slate-700">QR Scanner</span>
            </div>
          </div>
          <div class="p-4 scanner-wrap">
            <div class="scanner-viewport">
              <div id="qr-reader"></div>
              <div class="scan-corner scan-corner-tl"></div>
              <div class="scan-corner scan-corner-tr"></div>
              <div class="scan-corner scan-corner-bl"></div>
              <div class="scan-corner scan-corner-br"></div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="text-sm font-semibold text-slate-700">Stamp Actions</span>
            </div>
          </div>
          <div class="p-5 space-y-5">
            <div>
              <label for="boothSelect" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Booth</label>
              <div class="relative">
                <select id="boothSelect"
                  class="booth-select w-full rounded-xl border-2 border-slate-200 bg-white px-4 py-3 pr-10 text-sm font-semibold text-slate-800 focus:border-purple-500 focus:shadow-none cursor-pointer">
                  <option value="" class="py-3">— Select Booth —</option>
                  <% booths.forEach(function(b) { %>
                    <option value="<%= b.key %>" data-name="<%= b.name %>">
                      <%= b.name %> (Cat <%= b.category %>)
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div>
              <label for="playerId" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Player ID</label>
              <input id="playerId" type="text" maxlength="6"
                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-lg font-mono text-center uppercase tracking-widest focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-shadow placeholder:text-slate-300"
                placeholder="001" autocomplete="off" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <button onclick="issueStamp()" class="rounded-lg bg-emerald-600 py-3 text-sm font-bold text-white shadow-sm hover:bg-emerald-700 active:scale-[0.97] transition-all">Issue Stamp</button>
              <button onclick="revokeStamp()" class="rounded-lg bg-white py-3 text-sm font-semibold text-slate-600 border border-slate-300 shadow-sm hover:bg-slate-50 active:scale-[0.97] transition-all">Revoke</button>
            </div>
          </div>
          <div id="stamp-msg" class="hidden inline-msg border-slate-200" role="alert"></div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span class="text-sm font-semibold text-slate-700">Activity Log</span>
            </div>
            <span id="log-count" class="text-xs text-slate-400 font-medium">0 entries</span>
          </div>
          <div class="p-5">
            <div id="activity-log" class="space-y-2 min-h-[320px]">
              <div class="flex flex-col items-center justify-center py-16 text-center text-slate-400">
                <svg class="h-10 w-10 mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <p class="text-sm font-medium">No activity yet</p>
                <p class="text-xs text-slate-300 mt-1">Scan a QR code or enter a player ID to begin</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="/js/common.js"></script>
  <script>
    const csrfToken = '<%= csrfToken %>';
    let html5QrCode = null;
    let lastScanTime = 0;
    const logData = [];

    function addLog(msg, type, playerName) {
      const container = document.getElementById('activity-log');
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      logData.unshift({ msg, type, playerName, time });
      if (logData.length > 20) logData.pop();

      const countEl = document.getElementById('log-count');
      if (countEl) countEl.textContent = logData.length + ' entr' + (logData.length === 1 ? 'y' : 'ies');

      container.innerHTML = logData.map(l => {
        const isSuccess = l.type === 'success';
        const bg = isSuccess ? 'bg-emerald-50 border-emerald-200' : 'bg-red-50 border-red-200';
        const textColor = isSuccess ? 'text-emerald-800' : 'text-red-800';
        const iconColor = isSuccess ? 'text-emerald-600' : 'text-red-500';
        const iconBg = isSuccess ? 'bg-emerald-100' : 'bg-red-100';
        const iconSvg = isSuccess
          ? '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>'
          : '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
        return `
          <div class="flex items-start gap-3 p-3 rounded-lg border ${bg} animate-fade-in">
            <span class="font-mono text-xs text-slate-400 shrink-0 mt-0.5 min-w-[4.5rem]">${l.time}</span>
            <span class="h-6 w-6 rounded-full flex items-center justify-center shrink-0 ${iconBg} ${iconColor}">${iconSvg}</span>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold ${textColor} truncate">${l.playerName}</p>
              <p class="text-xs ${textColor} opacity-80">${l.msg}</p>
            </div>
          </div>
        `;
      }).join('');
    }

    async function issueStamp() {
      const boothSelect = document.getElementById('boothSelect');
      const booth = boothSelect.value;
      const boothName = boothSelect.options[boothSelect.selectedIndex].getAttribute('data-name');
      const id = document.getElementById('playerId').value.trim().toUpperCase();
      if (!booth || !id) { showMsg('Select booth and scan ID', 'error'); return; }

      const confirmed = await ConfirmModal.show({
        title: 'Issue Stamp',
        message: `Confirm issuing a stamp to player ${id} at ${boothName}?`,
        confirmText: 'Issue Stamp'
      });
      if (!confirmed) return;

      try {
        const res = await fetch('/api/admin/stamps/issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ boothKey: booth, uniqueId: id })
        });
        const data = await res.json();
        if (!res.ok) {
           showMsg(data.error || 'Issue failed', 'error');
           addLog(data.error || 'Failed to issue', 'error', id);
        } else {
           showMsg(`STAMP ISSUED: ${data.playerName}`, 'success');
           addLog(`Stamped at ${data.boothName}`, 'success', data.playerName);
           document.getElementById('playerId').value = '';
        }
      } catch(e) { }
    }

    async function revokeStamp() {
      const boothSelect = document.getElementById('boothSelect');
      const booth = boothSelect.value;
      const boothName = boothSelect.options[boothSelect.selectedIndex].getAttribute('data-name');
      const id = document.getElementById('playerId').value.trim().toUpperCase();
      if (!booth || !id) return;

      const confirmed = await ConfirmModal.show({
        title: 'Revoke Stamp',
        message: `Are you sure you want to revoke the stamp for player ${id} at ${boothName}? This action is logged.`,
        confirmText: 'Revoke Stamp',
        type: 'danger'
      });
      if (!confirmed) return;

      try {
        const res = await fetch('/api/admin/stamps/revoke', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ boothKey: booth, uniqueId: id })
        });
        const data = await res.json();
        if (!res.ok) {
           showMsg(data.error || 'Revoke failed', 'error');
           addLog(data.error || 'Failed to revoke', 'error', id);
        } else {
           showMsg(`REVOKED: ${data.playerName}`, 'success');
           addLog(`Revoked from ${data.boothName}`, 'error', data.playerName);
           document.getElementById('playerId').value = '';
        }
      } catch(e) { }
    }

    function showMsg(msg, type) {
      const el = document.getElementById('stamp-msg');
      el.className = `inline-msg ${type === 'error' ? 'bg-red-50 text-red-700 border-red-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'}`;
      el.textContent = msg;
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 4000);
    }

    function scanSuccessFlash() {
      const vp = document.querySelector('.scanner-viewport');
      if (!vp) return;
      const flash = document.createElement('div');
      flash.className = 'scan-success-flash';
      flash.innerHTML = '<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
      vp.appendChild(flash);
      setTimeout(() => flash.remove(), 900);
      document.querySelectorAll('.scan-corner').forEach(el => el.style.setProperty('--scan-clr', '#10b981'));
      setTimeout(() => document.querySelectorAll('.scan-corner').forEach(el => el.style.setProperty('--scan-clr', '#3b82f6')), 1500);
    }

    function initScanner() {
      html5QrCode = new Html5Qrcode("qr-reader");
      html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: { width: 250, height: 250 } }, (text) => {
        const now = Date.now();
        if (now - lastScanTime < 2000) return;
        lastScanTime = now;

        scanSuccessFlash();

        let id = text.trim();
        const match = id.match(/\/player\/([A-Z0-9]+)/i);
        if (match) id = match[1];

        document.getElementById('playerId').value = id.toUpperCase();
      }).catch(err => { });
    }

    document.addEventListener('DOMContentLoaded', initScanner);
  </script>
</body>
</html>
