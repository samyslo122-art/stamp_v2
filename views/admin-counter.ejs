<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Player Counter — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8' }}}}}
  </script>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .scanner-wrap { max-width: 360px; margin: 0 auto; }
  </style>
</head>
<body class="min-h-screen bg-slate-50">
  <%- include('partials/admin-nav', { active: 'counter' }) %>
  <%- include('partials/modal') %>

  <div id="toast-wrap"></div>

  <main class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex items-center gap-3 mb-8">
      <div class="h-11 w-11 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Player Counter</h1>
        <p class="text-sm text-slate-500">Register and search for players by QR code or manual entry</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
              <span class="text-sm font-semibold text-slate-700">QR Scanner</span>
            </div>
          </div>
          <div class="p-4 scanner-wrap">
            <div class="scanner-viewport">
              <div id="qr-reader"></div>
              <div class="scan-corner scan-corner-tl"></div>
              <div class="scan-corner scan-corner-tr"></div>
              <div class="scan-corner scan-corner-bl"></div>
              <div class="scan-corner scan-corner-br"></div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0"/></svg>
              <span class="text-sm font-semibold text-slate-700">Manual Entry / Search</span>
            </div>
          </div>
          <div class="p-5 space-y-4">
            <input id="mainQuery" type="text"
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-lg font-mono text-center uppercase tracking-widest focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-all placeholder:text-slate-300"
              placeholder="TYPE CODE OR NAME" autocomplete="off" />
            <div class="grid grid-cols-2 gap-3">
              <button onclick="registerPlayer()" class="rounded-lg bg-emerald-600 py-3 text-sm font-bold text-white shadow-sm hover:bg-emerald-700 active:scale-[0.97] transition-all">New Player</button>
              <button onclick="searchPlayers()" class="rounded-lg bg-blue-600 py-3 text-sm font-bold text-white shadow-sm hover:bg-blue-700 active:scale-[0.97] transition-all">Search</button>
            </div>
          </div>
          <div id="reg-msg" class="hidden inline-msg border-slate-200" role="alert"></div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span class="text-sm font-semibold text-slate-700">Search Results</span>
            </div>
          </div>
          <div class="p-5">
            <div id="search-results" class="space-y-4 min-h-[320px]">
              <div class="flex flex-col items-center justify-center py-16 text-center text-slate-400">
                <svg class="h-10 w-10 mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <p class="text-sm font-medium">No players selected</p>
                <p class="text-xs text-slate-300 mt-1">Scan a QR code or use the search box</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="/js/common.js"></script>
  <script>
    const csrfToken = '<%= csrfToken %>';
    let html5QrCode = null;
    let lastScanTime = 0;

    const mainInput = document.getElementById('mainQuery');
    mainInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchPlayers();
    });

    async function registerPlayer() {
      const code = mainInput.value.trim().toUpperCase();
      if (!code) return;
      try {
        const res = await fetch('/api/admin/players/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ groupCode: code })
        });
        const data = await res.json();
        const msgEl = document.getElementById('reg-msg');
        if (!res.ok) {
          msgEl.className = 'inline-msg bg-red-50 text-red-700 border-red-200';
          msgEl.textContent = data.error || 'Failed to create player';
        } else {
          msgEl.className = 'inline-msg bg-emerald-50 text-emerald-700 border-emerald-200';
          msgEl.textContent = `Successfully Created ${data.name}`;
          searchPlayers(data.uniqueId);
        }
      } catch(e) { }
    }

    async function searchPlayers(forceQuery) {
      const q = forceQuery || mainInput.value.trim();
      if (!q) return;
      try {
        const res = await fetch(`/api/admin/players/search?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        const container = document.getElementById('search-results');
        if (!res.ok || !data.players || data.players.length === 0) {
          container.innerHTML = '<div class="flex flex-col items-center justify-center py-16 text-center text-slate-400"><svg class="h-10 w-10 mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><p class="text-sm font-medium">No players matching that criteria found.</p></div>';
          return;
        }
        container.innerHTML = data.players.map(p => `
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-blue-300 transition-all group">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 font-bold text-lg">${p.name.charAt(p.name.length-1)}</div>
                <div>
                  <h4 class="font-bold text-slate-800">${p.name}</h4>
                  <p class="text-xs text-slate-500 font-mono tracking-tight">${p.group_code}</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold text-slate-400 uppercase">Unique ID</span>
                <p class="font-mono font-bold text-blue-600">${p.unique_id}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-50 rounded-xl p-4 flex flex-col items-center justify-center">
                 <img src="${p.qr_data_url}" class="w-24 h-24 rounded-lg shadow-sm bg-white p-1" />
                 <span class="text-[10px] font-bold text-slate-400 uppercase mt-2">Recovery QR</span>
              </div>
              <div class="flex flex-col justify-center gap-2">
                <a href="/player/${p.unique_id}" target="_blank" class="w-full py-2.5 rounded-lg bg-blue-50 text-blue-700 text-center text-xs font-bold hover:bg-blue-100 transition-colors">Open Portal</a>
                <div class="py-2.5 rounded-lg bg-slate-50 text-slate-600 text-center text-xs font-bold">Round ${p.current_round}</div>
              </div>
            </div>
          </div>
        `).join('');
      } catch(e) { }
    }

    function initScanner() {
      html5QrCode = new Html5Qrcode("qr-reader");
      html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: { width: 250, height: 250 } }, (text) => {
        const now = Date.now();
        if (now - lastScanTime < 2000) return;
        lastScanTime = now;

        let id = text.trim();
        const match = id.match(/\/player\/([A-Z0-9]{6})/i);
        if (match) id = match[1];

        mainInput.value = id.toUpperCase();
        scanSuccessFlash();
        searchPlayers();
      }).catch(err => { });
    }

    function scanSuccessFlash() {
      const vp = document.querySelector('.scanner-viewport');
      if (!vp) return;
      const flash = document.createElement('div');
      flash.className = 'scan-success-flash';
      flash.innerHTML = '<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
      vp.appendChild(flash);
      setTimeout(() => flash.remove(), 900);
      document.querySelectorAll('.scan-corner').forEach(el => el.style.setProperty('--scan-clr', '#10b981'));
      setTimeout(() => document.querySelectorAll('.scan-corner').forEach(el => el.style.setProperty('--scan-clr', '#3b82f6')), 1500);
    }

    document.addEventListener('DOMContentLoaded', initScanner);
  </script>
</body>
</html>
