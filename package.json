{
  "name": "school-event-passport",
  "version": "1.0.0",
  "description": "School Event Passport — Digital stamp collection system",
  "main": "server.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "dev": "node server.js",
