    "csrf-csrf": "^3.0.3",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  }
}
